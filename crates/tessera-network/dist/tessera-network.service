[Unit]
Description=tessera standalone network configuration and recovery
After=network.target
Wants=network.target
Before=network-online.target tesserad.service tessera-web.service

[Service]
Type=exec
User=root
Group=tessera-web
# tmpfiles owns both directories. The service group grants socket access only;
# the journal and private records are explicitly root:root (NE-6.2).
ExecStartPre=/usr/bin/tessera-network boot-recover
ExecStart=/usr/bin/tessera-network serve
Restart=on-failure
RestartSec=2s
TimeoutStartSec=120s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=~CAP_SYS_TIME
ProtectHome=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
# AF_PACKET is for /usr/bin/arping, the duplicate-address check of a static
# address (Revert, recovery and boot run it inside this service). Root already
# holds CAP_NET_RAW; nothing else in this unit opens a raw socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET

[Install]
WantedBy=multi-user.target
